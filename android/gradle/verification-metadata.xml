<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle dependency verification, scoped to the one dependency taken from JitPack (Tesseract4Android):
  its files must match these SHA-256 checksums or the build fails. Everything else (Google Maven and
  Maven Central) is trusted as before. To update Tesseract4Android, change the version in
  app/build.gradle.kts and replace the three checksums below with those of the new files.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!cz[.]adaptech[.]tesseract4android$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="cz.adaptech.tesseract4android" name="tesseract4android" version="4.9.0">
         <artifact name="tesseract4android-4.9.0.aar">
            <sha256 value="bce5d6413a1a5ae3d7240033fbbc851ba3217d0a08d9769400e17a077f42cb2a" origin="Downloaded from JitPack 2026-11-27"/>
         </artifact>
         <artifact name="tesseract4android-4.9.0.module">
            <sha256 value="7ee10fa26c3682c9a63fc27e4574335a135004d771cf92215febde3fbdb6f78a" origin="Downloaded from JitPack 2026-11-27"/>
         </artifact>
         <artifact name="tesseract4android-4.9.0.pom">
            <sha256 value="be3268bbfdc6755b23e4edcf2395fa70a253820caad8f5af5dafd679961be1c2" origin="Downloaded from JitPack 2026-11-27"/>
