{
  "appId": "io.pdfoundry.desktop",
  "productName": "PDFoundry",
  "copyright": "Copyright (c) 2026 Fahed Alhammadi",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "files": [
    "out/**/*",
    "!out/ocr/**",
    "package.json",
    "!node_modules/tesseract.js-core/*-lstm.{js,wasm}",
    "!node_modules/tesseract.js-core/*.wasm.js",
    "!node_modules/tesseract.js/dist/**",
    "!node_modules/tesseract.js/{docs,examples,scripts}/**"
  ],
  "extraResources": [
    {
      "from": "out/ocr",
      "to": "ocr"
    }
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/tesseract.js/**",
    "node_modules/tesseract.js-core/**",
    "node_modules/wasm-feature-detect/**",
    "node_modules/regenerator-runtime/**",
    "node_modules/zlibjs/**",
    "node_modules/bmp-js/**",
    "node_modules/is-url/**",
    "node_modules/idb-keyval/**",
    "node_modules/node-fetch/**",
    "node_modules/whatwg-url/**",
    "node_modules/tr46/**",
    "node_modules/webidl-conversions/**"
  ],
  "npmRebuild": false,
  "electronLanguages": [
    "en",
    "en-US"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "publish": [
    {
      "provider": "generic",
      "url": "https://github.com/Fahed-Alhammadi/PDFoundry/releases/latest/download"
    }
  ],
  "fileAssociations": [
    {
      "ext": "pdf",
      "name": "PDF document",
      "description": "PDF document",
      "mimeType": "application/pdf",
      "role": "Editor",
      "rank": "Alternate"
    }
  ],
  "mac": {
    "icon": "assets/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "notarize": false,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ]
  },
  "dmg": {
    "sign": true
  },
  "win": {
    "icon": "assets/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "icon": "assets/icon.png",
    "category": "Office",
    "synopsis": "Read, merge, edit and sign PDFs",
    "maintainer": "Fahed Alhammadi <Fahed-Alhammadi@users.noreply.github.com>",
    "mimeTypes": [
      "application/pdf"
    ],
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ]
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libgbm1",
      "libasound2 | libasound2t64"
    ]
  }
}
